# Copy to backend/.env and adjust. Placeholders only — never commit real keys.
DATABASE_PATH=data/audits.db
CORS_ORIGINS=http://localhost:5173

# Crawl safety ceilings (user input is clamped to these)
MAX_PAGES_LIMIT=200
MAX_DEPTH_LIMIT=5
DEFAULT_MAX_PAGES=30
DEFAULT_MAX_DEPTH=3
REQUEST_TIMEOUT_S=10
MAX_RESPONSE_BYTES=3000000
MAX_REDIRECTS=5
CONCURRENCY=4
CRAWL_DELAY_S=0.2
MAX_AUDIT_DURATION_S=300
LINK_CHECK_LIMIT=50
USER_AGENT=RankwiseSEOAuditBot/1.0 (+https://github.com/your-username/seo-audit)

# Local development ONLY: allow crawling localhost/private IPs (e.g. a site on your machine).
ALLOW_PRIVATE_HOSTS=false
# Set true only if outbound traffic must go through HTTP(S)_PROXY
USE_ENV_PROXY=false

# Optional AI executive summary. Leave LLM_PROVIDER=none to disable.
# LLM_PROVIDER: none | anthropic | openai
LLM_PROVIDER=none
LLM_API_KEY=your-api-key-here
# LLM_MODEL e.g. claude-haiku-5-5 or gpt-4o-mini (blank = provider default)
LLM_MODEL=
# LLM_BASE_URL: optional, for OpenAI-compatible endpoints
LLM_BASE_URL=
